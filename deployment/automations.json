{
  "schemaVersion": 1,
  "targets": {
    "uat": {
      "transactionalTransport": "gmailSmtp",
      "manualAttendance": "gmailSmtp",
      "interactiveAttendance": "paused"
    },
    "production": {
      "transactionalTransport": null,
      "manualAttendance": "pending_configuration",
      "interactiveAttendance": "pending_configuration"
    }
  },
  "transports": {
    "gmailSmtp": {
      "host": "smtp.gmail.com",
      "port": 465,
      "settings": {
        "from": "SMTP_FROM_EMAIL",
        "user": "SMTP_USER",
        "host": "SMTP_HOST",
        "port": "SMTP_PORT",
        "password": "SMTP_PASSWORD"
      }
    },
    "attendanceAmp": {
      "approvedSenderDomain": "letsaimit.com",
      "settings": {
        "from": "COACHING_FROM_EMAIL",
        "user": "COACHING_SMTP_USER",
        "host": "COACHING_SMTP_HOST",
        "port": "COACHING_SMTP_PORT",
        "password": "COACHING_SMTP_PASSWORD",
        "ticketSigningSecret": "COACHING_EMAIL_SIGNING_SECRET",
        "providerReady": "COACHING_DYNAMIC_EMAIL_READY"
      },
      "requiresGoogleSenderApproval": true
    }
  },
  "sharedFunctionSettings": ["NOTIFICATION_CRON_SECRET", "ADMIN_DASHBOARD_ORIGIN"],
  "automations": {
    "registrationAndActivity": {
      "worker": "admin-notifications",
      "transport": "gmailSmtp",
      "cronJob": "letsaimit-admin-notifications",
      "cronSchedule": "* * * * *",
      "dispatchSetting": "private.notification_settings.dispatch_enabled",
      "recipients": "Current approved admins",
      "registrationAlert": "After a saved trial or enrolment request",
      "activityReport": {
        "windowHours": 4,
        "windowTimezone": "UTC",
        "displayTimezone": "Asia/Kolkata",
        "skipEmptyWindows": true
      }
    },
    "billing": {
      "worker": "billing-worker",
      "transport": "gmailSmtp",
      "cronJob": "letsaimit-billing-worker",
      "cronSchedule": "* * * * *",
      "dispatchSetting": "private.billing_settings.enabled",
      "parentEmails": ["Invoices", "Reminders", "Receipts", "Refunds", "Fee changes"],
      "reminderSlotsIst": ["09:00", "12:00", "15:00", "18:00"],
      "adminSummary": "Last day of the month, from 18:00 IST"
    },
    "attendance": {
      "worker": "coaching-worker",
      "transport": "attendanceAmp",
      "manualFallbackTransport": "gmailSmtp",
      "cronJob": "letsaimit-coaching-attendance",
      "cronSchedule": "* * * * *",
      "dailyAt": "21:00",
      "timezone": "Asia/Kolkata",
      "manualTrigger": "send_coaching_attendance_now",
      "statusRpc": "get_coaching_attendance_email_status",
      "actionRoute": "coaching-worker/attendance",
      "dispatchSetting": "private.coaching_settings.email_enabled",
      "manualDispatchSetting": "private.coaching_settings.manual_email_enabled",
      "recipients": "One email per current approved admin per session date",
      "maxRosterSize": 100,
      "ticketLifetimeHours": 48,
      "actions": ["Present", "Absent", "No session"]
    }
  },
  "otherAutomations": {
    "accountDeletion": {
      "platform": "Supabase",
      "worker": "delete-account",
      "trigger": "Confirmed account deletion request",
      "cronJob": "letsaimit-account-deletions",
      "cronSchedule": "* * * * *",
      "settings": ["ADMIN_DASHBOARD_ORIGIN", "NOTIFICATION_CRON_SECRET"],
      "vaultEntries": ["letsaimit_notification_worker_url", "letsaimit_notification_worker_secret"],
      "source": "supabase/migrations/20261110190347_account_deletion.sql"
    },
    "uatDatabaseHealth": {
      "platform": "Vercel",
      "project": "letsaimit-uat-health",
      "target": "uat",
      "route": "/api/cron/supabase",
      "rpc": "registration_health",
      "cronSchedule": "0 6 */3 * *",
      "timezone": "UTC",
      "settings": ["CRON_SECRET", "SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY"],
      "source": "deployment/uat-health/vercel.json"
    },
    "razorpayEvents": {
      "platform": "Supabase",
      "worker": "razorpay-webhook",
      "trigger": "Signed Razorpay invoice, payment or refund event",
      "settings": ["RAZORPAY_WEBHOOK_SECRET"],
      "source": "supabase/functions/razorpay-webhook/index.ts"
    },
    "societyAndSchoolEnquiries": {
      "platform": "Google Apps Script",
      "trigger": "Society or school form submitted",
      "destination": "Private Google Sheet",
      "websiteSettings": ["VITE_LEAD_ENDPOINT"],
      "scriptProperties": ["LETSAIMIT_LEAD_SHEET_ID"],
      "source": "integrations/google-sheets/Code.gs"
    }
  }
}
