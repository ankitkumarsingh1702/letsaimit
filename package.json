{
  "name": "letsaimit-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LetsAimIt coaching website and student workspaces with prerendered public pages and search discovery.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prerender.mjs && node scripts/prune-deployment.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "verify:assets": "node scripts/verify-assets.mjs",
    "parity:plan": "node scripts/backend-parity.mjs",
    "release:build": "node scripts/check-release.mjs && node scripts/backend-parity.mjs > /tmp/letsaimit-backend-parity.json && npm test && npm run build",
    "test": "node --test",
    "test:indexing": "python3 -m unittest discover -s tests -p force_index_test.py",
    "index:check": "python3 scripts/force-index.py --dry-run",
    "index:submit": "python3 scripts/force-index.py --submit",
    "discovery:baseline": "node scripts/discovery-baseline.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "ag-grid-community": "36.3.0",
    "ag-grid-react": "36.3.0",
    "libphonenumber-js": "1.13.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5"
  }
}
