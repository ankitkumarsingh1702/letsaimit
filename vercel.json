{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = uat ]; then export VITE_SITE_ORIGIN=https://uat.letsaimit.com; elif [ \"$VERCEL_ENV\" = preview ] && [ -n \"$VERCEL_URL\" ]; then export VITE_SITE_ORIGIN=\"https://$VERCEL_URL\"; fi; npm run release:build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+/",
      "permanent": true
    },
    {
      "source": "/programme",
      "destination": "/programme/",
      "permanent": true
    },
    {
      "source": "/coach",
      "destination": "/coach/",
      "permanent": true
    },
    {
      "source": "/societies",
      "destination": "/societies/",
      "permanent": true
    },
    {
      "source": "/schools",
      "destination": "/schools/",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/blogs",
      "destination": "/blogs/",
      "permanent": true
    },
    {
      "source": "/blogs/first-football-session",
      "destination": "/blogs/first-football-session/",
      "permanent": true
    },
    {
      "source": "/blogs/encouragement-without-pressure",
      "destination": "/blogs/encouragement-without-pressure/",
      "permanent": true
    },
    {
      "source": "/blogs/questions-about-training-preparation",
      "destination": "/blogs/questions-about-training-preparation/",
      "permanent": true
    },
    {
      "source": "/blogs/first-community-match",
      "destination": "/blogs/first-community-match/",
      "permanent": true
    },
    {
      "source": "/bengaluru",
      "destination": "/bengaluru/",
      "permanent": true
    },
    {
      "source": "/bengaluru/football-coaching",
      "destination": "/bengaluru/football-coaching/",
      "permanent": true
    },
    {
      "source": "/bengaluru/basketball-coaching",
      "destination": "/bengaluru/basketball-coaching/",
      "permanent": true
    },
    {
      "source": "/bengaluru/nambiar-bellezea",
      "destination": "/bengaluru/nambiar-bellezea/",
      "permanent": true
    },
    {
      "source": "/bengaluru/nambiar-ellegenza",
      "destination": "/bengaluru/nambiar-ellegenza/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/refunds",
      "destination": "/refunds/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/sign-in",
      "destination": "/sign-in/",
      "permanent": true
    },
    {
      "source": "/register",
      "destination": "/register/",
      "permanent": true
    },
    {
      "source": "/parent",
      "destination": "/parent/",
      "permanent": true
    },
    {
      "source": "/coach-dashboard",
      "destination": "/coach-dashboard/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions/",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/refund-policy",
      "destination": "/refunds/",
      "permanent": true
    },
    {
      "source": "/refund-policy/",
      "destination": "/refunds/",
      "permanent": true
    },
    {
      "source": "/blogs/choosing-football-coaching-bengaluru",
      "destination": "/blogs/choosing-football-coaching-bengaluru/",
      "permanent": true
    },
    {
      "source": "/blogs/choosing-basketball-coaching-bengaluru",
      "destination": "/blogs/choosing-basketball-coaching-bengaluru/",
      "permanent": true
    },
    {
      "source": "/blogs/football-or-basketball-for-beginners",
      "destination": "/blogs/football-or-basketball-for-beginners/",
      "permanent": true
    },
    {
      "source": "/blogs/first-basketball-session",
      "destination": "/blogs/first-basketball-session/",
      "permanent": true
    },
    {
      "source": "/blogs/beginner-basketball-skills",
      "destination": "/blogs/beginner-basketball-skills/",
      "permanent": true
    },
    {
      "source": "/blogs/beginner-football-rules-and-skills",
      "destination": "/blogs/beginner-football-rules-and-skills/",
      "permanent": true
    },
    {
      "source": "/blogs/society-sports-coaching-checklist",
      "destination": "/blogs/society-sports-coaching-checklist/",
      "permanent": true
    },
    {
      "source": "/blogs/understanding-your-childs-practice-progress",
      "destination": "/blogs/understanding-your-childs-practice-progress/",
      "permanent": true
    },
    {
      "source": "/blogs/balancing-sport-and-school",
      "destination": "/blogs/balancing-sport-and-school/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "letsaimit\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/:page(admin|parent|coach-dashboard|sign-in|register|404)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/:file(llms|llms-full).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/:path*.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
