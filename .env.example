# Website build origin; shared public branding always uses letsaimit.com.
# The UAT Vercel build sets its own site origin without changing the public brand.
VITE_SITE_ORIGIN=https://letsaimit.com

# Optional. No analytics loads until this is set and the visitor consents.
VITE_GA4_ID=
# Disable Enhanced Measurement and user-provided data collection in the GA4 stream
# before setting this true. Automatic outbound clicks could expose WhatsApp text.
VITE_GA4_MANUAL_EVENTS_ONLY_CONFIRMED=false

# Public Apps Script web app URL ending in /exec (never a Google access token).
# Deploy integrations/google-sheets/Code.gs in the owner's Google account first.
VITE_LEAD_ENDPOINT=

# Supabase public project settings. Set only for the intended environment.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional newer public-key naming; takes precedence over the legacy anon key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only settings for the scheduled database health check.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
CRON_SECRET=
